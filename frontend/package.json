{
  "name": "zipzop-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/sync-luts.mjs && next dev",
    "build": "node scripts/sync-luts.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "node scripts/sync-luts.mjs && vitest run",
    "test:watch": "node scripts/sync-luts.mjs && vitest",
    "generate:types": "openapi-typescript ../openapi.json -o src/lib/api/generated.ts",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2",
    "immer": "^10.1.1",
    "@tanstack/react-query": "^5.62.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.4.49",
    "prettier": "^3.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
