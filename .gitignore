# ---- security register ----
# docs/07-security.md §2 and §9: findings and reproductions live in a PRIVATE
# register, never in a public issue. This repository answers anonymous API
# calls, so it is public — the register stays out of it. Keep a copy somewhere
# private (a private repository, a password manager's secure notes).
security/

# ---- secrets ----
.env
.env.*
!.env.example
*.pem
*.key
!**/testdata/*.key

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# ---- node ----
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.pnpm-store/

# ---- generated ----
# openapi.json IS committed on purpose: it is the contract both sides build
# against, and a diff on it should show up in review.
frontend/src/lib/api/generated.ts

# M1 spike fixtures: two encoded proxies and a 33^3 LUT, ~2.5 MB of binary and
# machine-written text that no review reads. `make spike-media` rebuilds them
# byte-identically from scripts/.
frontend/public/spike/media/
frontend/public/spike/luts/

# The browser's copy of the grades. `backend/app/assets/luts/` is the source of
# truth — the renderer needs them on disk and the image is built from backend/ —
# and `pnpm dev|build|test` copies them here. Committing both is two files that
# are meant to be identical and a day when they are not.
frontend/public/luts/

# The end-to-end fixture, same reasoning: 2 MB of encoded video that no review
# reads. `make e2e-media` rebuilds it.
frontend/e2e/fixture.mp4

# Backend test media, generated by the pytest fixtures on first run.
backend/.pytest-media/

# ---- local infrastructure ----
.docker-data/
minio-data/
postgres-data/

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- scratch ----
scratch/
tmp/
*.log
