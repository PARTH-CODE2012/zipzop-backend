# Copy to .env and adjust. Never commit .env.
# Every variable the application reads is listed here, including the ones that
# are not used until a later milestone — an empty value is better than a
# variable nobody knew existed.

# ---------------------------------------------------------------- environment
ENVIRONMENT=local              # local | staging | production
DEBUG=true
LOG_LEVEL=INFO

# ---------------------------------------------------------------------- api
# 8123 and 3123 rather than 8000 and 3000, which are the two most contested
# ports on a developer's machine — every Python service and every Next app want
# them. `scripts/ports.sh` steps over either one if something holds it anyway,
# and tells the frontend where the API really landed. Change them here and
# every entry point follows.
API_HOST=0.0.0.0
API_PORT=8123
WEB_PORT=3123
# Both spellings of the same origin: a browser sent to 127.0.0.1 and one sent
# to localhost present different Origin headers, and a list with only one of
# them rejects half the ways of opening the app.
CORS_ORIGINS=http://localhost:3123,http://127.0.0.1:3123

# ----------------------------------------------------------------- database
# Inside docker compose the host is "postgres"; from your shell it is localhost.
DATABASE_URL=postgresql+asyncpg://zipzop:zipzop@localhost:5432/zipzop
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# -------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# -------------------------------------------------------------------- auth
# Local dev signs with HS256 and a shared secret. Production uses RS256 per
# docs/03-backend-architecture.md §10 — set JWT_ALGORITHM=RS256 and point
# JWT_PRIVATE_KEY_PATH / JWT_PUBLIC_KEY_PATH at a real key pair.
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=dev-only-change-me-before-anything-leaves-your-laptop
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------- speech
# Self-hosted faster-whisper. `base` is the working default; `small` is better
# on accented speech and about twice as slow. The model downloads on first use.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ------------------------------------------------------------------ storage
# MinIO locally, real S3 in staging and production. Same protocol either way,
# which is what makes the AWS account unnecessary to start building.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-west-1
S3_BUCKET=zipzop-media
S3_ACCESS_KEY_ID=zipzop
S3_SECRET_ACCESS_KEY=zipzop-dev-secret
S3_FORCE_PATH_STYLE=true       # required by MinIO, false on real S3
UPLOAD_URL_TTL_SECONDS=900     # 15 min
DOWNLOAD_URL_TTL_SECONDS=3600  # 1 h
CDN_BASE_URL=http://localhost:9000/zipzop-media

# ------------------------------------------------------------------- limits
MAX_UPLOAD_BYTES=2147483648    # 2 GB
MAX_DURATION_MS=3600000        # 60 min
MULTIPART_THRESHOLD_BYTES=104857600  # 100 MB

# ------------------------------------------------------------------ billing
# Not needed until M6. Test keys are enough — no real money moves in dev.
#
# Razorpay is the launch provider (25 August, docs/13-mvp-direction.md).
# Stripe is deferred, not dropped — the variables stay so the second adapter
# needs no configuration change when it arrives.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Razorpay hands you a **pair**, and its own dashboard labels them in a way that
# hides which one matters:
#
#   RAZORPAY_KEY_ID      starts `rzp_test_` or `rzp_live_`. Public by design —
#                        it goes in the browser bundle, like Stripe's
#                        publishable key. Safe to share, safe to log.
#   RAZORPAY_KEY_SECRET  the random string beside it. **This one is a
#                        credential**, in test mode as much as in live mode.
#                        Never commit it, never log it, never paste it into a
#                        document or a chat.
#
# ⚠️ A test Key Secret is still a secret. It is often passed around as "the
# test key", which makes it sound like sample data — it is not. It signs API
# calls against a real Razorpay account, and a secret that lives in a repository
# in test mode is a secret that will live there in live mode. docs/07-security.md
# §2 says any live secret found is rotated within the hour; treat these the same.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# A **third** secret, and not part of the pair above. It does not exist until a
# webhook endpoint is created in the Razorpay dashboard, where you choose it.
# Without it the signature check on incoming webhooks cannot be exercised — and
# that check is the whole defence on the billing path (contract §8.5:
# verify signature -> store in provider_events -> 200 -> process async).
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------------------- frontend
# Read by Next.js. NEXT_PUBLIC_ variables are exposed to the browser, so
# nothing secret ever goes here.
# Overwritten by scripts/ports.sh when a port had to move, so the browser is
# never left pointing at a port the API did not get.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8123/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8123/v1/ws
